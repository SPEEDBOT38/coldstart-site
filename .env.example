# Coldstart server config. Copy to .env locally; set the same keys in Vercel → Settings → Environment Variables.
# Anything left blank keeps that plugin in sandbox mode.

# Required in production: seals the connection cookie and stored tokens (≥32 random chars)
SESSION_SECRET=

# Public URL the OAuth redirect URIs are built from (no trailing slash). Defaults to the request host.
APP_URL=

# Server-side store for relay site keys, Shopify routes and delivery logs.
# Vercel: add an Upstash Redis (Marketplace) integration; it sets these automatically.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Enabled plugins (comma list). Empty = all.
PLUGINS=

# --- Capabilities (see docs/CAPABILITIES.md) ---
TREG_TOKEN=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_FAST_MODEL=gemini-flash-lite-latest
OPENROUTER_API_KEY=
FIRECRAWL_API_KEY=
RESEARCH_DAILY_SCANS=60
AI_DAILY_CALLS=300

# --- Meta (Facebook Login for Business) ---
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
META_GRAPH_VERSION=v23.0

# --- Shopify (custom/public app) ---
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_API_VERSION=2025-10

# --- Reddit (web app) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=web:coldstart:0.2 (by /u/yourname)

# --- X (OAuth 2.0, confidential or public client) ---
X_CLIENT_ID=
X_CLIENT_SECRET=
